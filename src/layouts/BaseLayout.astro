---
import '@fontsource-variable/overpass';
import overpassLatin from '@fontsource-variable/overpass/files/overpass-latin-wght-normal.woff2?url';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import CookieBanner from '../components/CookieBanner.astro';
import { SITE, HGV_SERVICES, AREAS, PRICES_INCLUDE_VAT, type Service } from '../config/site';

interface Props {
  title: string;
  description: string;
  /** Extra JSON-LD objects for this page (FAQPage, BreadcrumbList, Service). */
  schema?: Record<string, unknown>[];
  noindex?: boolean;
}
const { title, description, schema = [], noindex = false } = Astro.props;
const site = Astro.site!;
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, ''), site).href.replace(/\/$/, '') || site.href;
const ogImage = new URL('/og-image.png', site).href;

const offer = (s: Service, category: string) => ({
  '@type': 'Offer',
  itemOffered: { '@type': 'Service', name: s.title, description: s.description, category },
  priceSpecification: { '@type': 'PriceSpecification', price: s.priceFrom.replace('£', ''), minPrice: s.priceFrom.replace('£', ''), priceCurrency: 'GBP', valueAddedTaxIncluded: PRICES_INCLUDE_VAT },
  areaServed: { '@type': 'GeoCircle', geoMidpoint: { '@type': 'GeoCoordinates', latitude: SITE.mapCoords.lat, longitude: SITE.mapCoords.lng }, geoRadius: Math.round(SITE.operatingMiles * 1609.344) },
});

const business = {
  '@context': 'https://schema.org',
  '@type': ['AutomotiveBusiness', 'Locksmith'],
  '@id': `${site.href}#business`,
  name: SITE.name,
  alternateName: SITE.shortName,
  description: SITE.tagline,
  url: site.href,
  telephone: SITE.phoneTel,
  image: ogImage,
  logo: new URL('/logo.png', site).href,
  priceRange: '££',
  currenciesAccepted: 'GBP',
  paymentAccepted: SITE.payment.join(', '),
  address: { '@type': 'PostalAddress', addressLocality: SITE.baseTown, addressRegion: SITE.baseRegion, addressCountry: 'GB' },
  geo: { '@type': 'GeoCoordinates', latitude: SITE.mapCoords.lat, longitude: SITE.mapCoords.lng },
  areaServed: [
    ...AREAS.map((a) => ({ '@type': 'City', name: a.name })),
    { '@type': 'GeoCircle', geoMidpoint: { '@type': 'GeoCoordinates', latitude: SITE.mapCoords.lat, longitude: SITE.mapCoords.lng }, geoRadius: Math.round(SITE.operatingMiles * 1609.344) },
  ],
  openingHoursSpecification: [{ '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'], opens: '00:00', closes: '23:59' }],
  contactPoint: [{ '@type': 'ContactPoint', telephone: SITE.phoneTel, contactType: 'customer service', availableLanguage: 'English', hoursAvailable: '24/7' }],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Mobile HGV locksmith and diagnostics services',
    itemListElement: HGV_SERVICES.map((s) => offer(s, 'HGV & Lorries')),
  },
};
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#0B4EA2" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href={overpassLatin} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE.name}: ${SITE.tagline}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(business)} />
    {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body class="flex min-h-dvh flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-[100] focus:bg-plate focus:px-4 focus:py-3 focus:font-extrabold focus:text-ink">Skip to content</a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
    <MobileBar />
    <CookieBanner />
  </body>
</html>
