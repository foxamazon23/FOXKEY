---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import ServiceEntry from '../components/ServiceEntry.astro';
import ProofNotice from '../components/ProofNotice.astro';
import CallBand from '../components/CallBand.astro';
import Icon from '../components/Icon.astro';
import { SEO, SITE, CAR_SERVICES, CAR_CALLOUT, GENERAL_PRICE_NOTE, WARRANTY_TEXT, HOME } from '../config/site';

const short = (t: string) => t.split(' – ')[0].split(' (')[0];
const tips: Record<string, string> = {
  'spare-key': 'If you are down to one key, this is the cheapest time to sort it.',
  'all-keys-lost': 'Tell us where the car is and whether it is locked. We open it without damage first.',
};
---
<BaseLayout title={SEO.services.title} description={SEO.services.description}>
  <PageHead
    title="Car and van keys, diagnostics and coding"
    lead="Every job below is done at the vehicle: on your drive, at work, in a car park or at the roadside. Prices are starting prices, confirmed by phone before we travel."
    crumbs={[{ label: 'Cars & Vans' }]}
  >
    <div id="hero-cta" class="mt-8 flex flex-wrap gap-3">
      <a href={`tel:${SITE.phoneTel}`} class="btn btn-call btn-lg num w-full sm:w-auto"><Icon name="phone" class="h-5 w-5" />Call {SITE.phoneDisplay}</a>
      <a href="/quote" class="btn btn-outline-light btn-lg w-full sm:w-auto">Request a quote</a>
    </div>
  </PageHead>

  <section class="band">
    <div class="wrap grid gap-x-14 gap-y-8 lg:grid-cols-[15rem_minmax(0,1fr)]">
      <nav aria-label="Services on this page" class="lg:sticky lg:top-28 lg:self-start">
        <p class="t-label mb-2">On this page</p>
        <ul class="border-t-[3px] border-ink">
          {CAR_SERVICES.map((s) => (
            <li class="border-b border-line"><a href={`#${s.id}`} class="flex items-baseline justify-between gap-3 py-2.5 t-ui font-bold text-ink no-underline hover:underline"><span>{short(s.title)}</span><span class="num shrink-0 text-muted">{s.priceFrom}</span></a></li>
          ))}
        </ul>
      </nav>
      <div>
        {CAR_SERVICES.map((s) => <ServiceEntry service={s} tip={tips[s.id]} />)}
        <div class="mt-9 flex flex-wrap items-baseline justify-between gap-3 bg-plate-soft p-5">
          <h2 class="text-[1.25rem] font-black">{CAR_CALLOUT.title}</h2>
          <p class="t-ui font-bold">{CAR_CALLOUT.text}</p>
        </div>
        <div class="mt-9 grid gap-6 md:grid-cols-2">
          <div>
            <h2 class="t-h3">How the price is set</h2>
            <p class="mt-2 t-body text-ink">{GENERAL_PRICE_NOTE}</p>
          </div>
          <div>
            <h2 class="t-h3">Warranty</h2>
            <p class="mt-2 t-body text-ink">{WARRANTY_TEXT}</p>
            <h2 class="t-h3 mt-6">Paying</h2>
            <p class="mt-2 t-body text-ink">{SITE.payment.join(', ')}. For key work you pay once the vehicle starts.</p>
          </div>
        </div>
        <ProofNotice class="mt-9" headingLevel="h2" />
      </div>
    </div>
  </section>

  <section class="band bg-surface">
    <div class="wrap">
      <h2 class="t-h2 max-w-2xl">{HOME.steps.title}</h2>
      <ol class="mt-8 grid gap-4 md:grid-cols-3">
        {HOME.steps.items.map((s, i) => (
          <li class="flex gap-4 rounded-md bg-paper p-5">
            <span class="num flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-plate font-black text-plate-ink">{i + 1}</span>
            <div><h3 class="font-extrabold">{s.title}</h3><p class="mt-1 t-ui text-muted">{s.text}</p></div>
          </li>
        ))}
      </ol>
      <p class="mt-8 t-ui">Driving a lorry or HGV? <a href="/hgv" class="link">See HGV and lorry services</a>.</p>
    </div>
  </section>

  <CallBand />
</BaseLayout>
