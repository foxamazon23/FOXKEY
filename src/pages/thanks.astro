---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { SEO, SITE } from '../config/site';
---
<BaseLayout title={SEO.thanks.title} description={SEO.thanks.description} noindex>
  <section class="band-lg">
    <div class="wrap max-w-2xl">
      <Icon name="circle-check" class="h-10 w-10 text-fox" />
      <h1 class="t-h1 mt-6">Message received</h1>
      <p class="t-lead mt-4">We will ring you back as soon as we can. If the vehicle is stuck right now, do not wait for us. Ring and we will get moving.</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={`tel:${SITE.phoneTel}`} class="btn btn-call btn-lg num"><Icon name="phone" class="h-5 w-5" />{SITE.phoneDisplay}</a>
        <a href="/" class="btn btn-quiet btn-lg">Back to the home page</a>
      </div>
    </div>
  </section>
</BaseLayout>
