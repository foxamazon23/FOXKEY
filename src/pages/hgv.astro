---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceEntry from '../components/ServiceEntry.astro';
import ProofNotice from '../components/ProofNotice.astro';
import DontDo from '../components/DontDo.astro';
import Faq from '../components/Faq.astro';
import CoverageMap from '../components/CoverageMap.astro';
import CallBand from '../components/CallBand.astro';
import Icon from '../components/Icon.astro';
import {
  SEO, SITE, HGV_PAGE, HGV_SERVICES, HGV_CALLOUT, HGV_PRICE_NOTE, FLEET, FAQ_HGV, VAT_LABEL,
  enabledTruckMakes,
} from '../config/site';

const from = '£' + Math.min(...HGV_SERVICES.map((s) => Number(s.priceFrom.replace('£', ''))));
const crumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: 'HGV services', item: new URL('/hgv', Astro.site).href },
  ],
};
---
<BaseLayout title={SEO.hgv.title} description={SEO.hgv.description} schema={[crumbs]}>
  <section class="on-sign bg-sign text-on-sign">
    <div class="wrap grid items-center gap-x-14 gap-y-10 pt-8 pb-14 md:pt-10 md:pb-20 lg:grid-cols-[1.15fr_0.85fr]">
      <div>
        <nav aria-label="Breadcrumb" class="mb-6 t-ui">
          <ol class="flex flex-wrap items-center gap-2"><li><a href="/" class="text-on-sign underline">Home</a></li><li aria-hidden="true">›</li><li><span aria-current="page" class="font-bold">HGV services</span></li></ol>
        </nav>
        <h1 class="t-display-long">{HGV_PAGE.heroTitle}</h1>
        <p class="mt-6 max-w-xl text-[1.1875rem] leading-relaxed text-on-sign-muted">{HGV_PAGE.heroSubtitle()}</p>
        <div id="hero-cta" class="mt-9 flex flex-wrap gap-3">
          <a href={`tel:${SITE.phoneTel}`} class="btn btn-call btn-lg num w-full sm:w-auto"><Icon name="phone" class="h-5 w-5" />Call {SITE.phoneDisplay}</a>
          <a href={SITE.whatsappPrefill} target="_blank" rel="noopener" class="btn btn-outline-light btn-lg w-full sm:w-auto">WhatsApp</a>
        </div>
        <p class="mt-5 max-w-lg t-ui text-on-sign-muted">{HGV_PAGE.heroNote}</p>
      </div>
      <div class="sign p-6 sm:p-8">
        <p class="flex gap-2"><span class="shield">M62</span><span class="shield">M18</span></p>
        <p class="mt-5 text-[1.5rem] leading-tight font-black">{HGV_CALLOUT.title}</p>
        <p class="mt-2 t-ui text-on-sign-muted">{HGV_CALLOUT.text}</p>
        <dl class="mt-6 grid grid-cols-2 gap-4 border-t-2 border-on-sign pt-5">
          <div><dt class="t-label text-on-sign-muted">HGV work from</dt><dd class="num mt-1 text-[2rem] leading-none font-black">{from}<span class="ml-1 text-base font-bold">{VAT_LABEL}</span></dd></div>
          <div><dt class="t-label text-on-sign-muted">Hours</dt><dd class="mt-1 text-[2rem] leading-none font-black">{SITE.hoursShort}</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="hgv-services">
    <div class="wrap">
      <div class="max-w-2xl">
        <h2 id="hgv-services" class="t-h2">HGV and lorry services</h2>
        <p class="t-lead mt-3">{HGV_PRICE_NOTE}</p>
      </div>
      <div class="mt-8">
        {HGV_SERVICES.map((s) => <ServiceEntry service={s} level="h3" />)}
      </div>
      <div class="mt-9 flex flex-wrap items-baseline justify-between gap-3 bg-plate-soft p-5">
        <h3 class="text-[1.25rem] font-black">{HGV_CALLOUT.title}</h3>
        <p class="t-ui font-bold">{HGV_CALLOUT.text}</p>
      </div>
      <ProofNotice class="mt-6" />
    </div>
  </section>

  <section class="band bg-surface">
    <div class="wrap grid gap-x-14 gap-y-10 lg:grid-cols-[0.9fr_1.1fr]">
      <div>
        <h2 class="t-h2">Lorries we work on</h2>
        <p class="t-lead mt-3">We list a truck make only once our equipment covers it. Not listed? Ring with the registration and we will tell you.</p>
        <ul class="mt-8 border-t-[3px] border-ink">
          {enabledTruckMakes().map((m) => <li class="border-b border-line bg-paper px-3 py-3 font-bold">{m.name}</li>)}
        </ul>
        <a href="/makes" class="link mt-5 inline-block">Every make we cover</a>
      </div>
      <DontDo class="self-start" />
    </div>
  </section>

  <section class="band">
    <div class="wrap grid gap-x-14 gap-y-8 lg:grid-cols-[0.9fr_1.1fr]">
      <div>
        <h2 class="t-h2">{FLEET.title}</h2>
        <p class="t-lead mt-3">{FLEET.intro}</p>
        <a href={FLEET.cta.href} class="btn btn-ink btn-lg mt-7 w-full sm:w-auto">{FLEET.cta.label}<Icon name="arrow-right" class="h-5 w-5" /></a>
      </div>
      <ul class="grid gap-x-8 sm:grid-cols-2">
        {FLEET.benefits.map((b) => (
          <li class="border-t-[3px] border-ink py-5">
            <h3 class="font-extrabold">{b.title}</h3>
            <p class="mt-1 t-ui text-muted">{b.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="band bg-surface">
    <div class="wrap grid gap-x-14 gap-y-8 lg:grid-cols-[0.8fr_1.2fr]">
      <div>
        <h2 class="t-h2">Where we cover</h2>
        <p class="t-lead mt-3">Free call-out within {SITE.freeCalloutMiles} road miles of Goole, which takes in Selby, Doncaster, Scunthorpe and the M62 and M18 junctions between them. We travel up to {SITE.operatingMiles} miles from Goole for lorry work; beyond the free zone, the travel is quoted before we set off.</p>
        <a href="/areas" class="link mt-5 inline-block">Every area we cover</a>
      </div>
      <CoverageMap id="hgv-map" class="mx-auto w-full max-w-[24rem]" />
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <h2 class="t-h2">HGV questions</h2>
      <div class="mt-8 max-w-4xl"><Faq items={FAQ_HGV} /></div>
      <a href="/faq" class="link mt-6 inline-block">All questions</a>
    </div>
  </section>

  <CallBand title="Lorry off the road?" text="Ring with the registration and where it is parked. We confirm the price before we travel, day or night." />
</BaseLayout>
