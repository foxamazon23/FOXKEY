---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import NoSign from '../components/NoSign.astro';
import { SITE } from '../config/site';
---
<BaseLayout title={`Page not found | ${SITE.shortName}`} description="This page does not exist." noindex>
  <section class="band-lg">
    <div class="wrap max-w-2xl">
      <NoSign class="h-14 w-14" />
      <h1 class="t-h1 mt-5">No entry: this page does not exist</h1>
      <p class="t-lead mt-4">The link may be old or mistyped. These will get you back on the road.</p>
      <ul class="mt-6 flex flex-wrap gap-x-6 gap-y-2">
        <li><a href="/" class="link">Home</a></li>
        <li><a href="/services" class="link">Cars &amp; Vans</a></li>
        <li><a href="/hgv" class="link">HGV &amp; Lorries</a></li>
        <li><a href="/prices" class="link">Prices</a></li>
        <li><a href="/contact" class="link">Contact</a></li>
      </ul>
      <div id="hero-cta" class="mt-8">
        <a href={`tel:${SITE.phoneTel}`} class="btn btn-call btn-lg num w-full sm:w-auto"><Icon name="phone" class="h-5 w-5" />Call {SITE.phoneDisplay}</a>
      </div>
    </div>
  </section>
</BaseLayout>
