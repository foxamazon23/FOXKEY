---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import CoverageMap from '../../components/CoverageMap.astro';
import CallBand from '../../components/CallBand.astro';
import { SEO, SITE, AREAS, REACH } from '../../config/site';
const sorted = [...AREAS].sort((a, b) => a.roadMiles - b.roadMiles || a.name.localeCompare(b.name));
---
<BaseLayout title={SEO.areas.title} description={SEO.areas.description}>
  <PageHead
    title="Areas we cover"
    lead={`${SITE.baseDescription} We travel up to ${SITE.operatingMiles} miles for lorry work. Call-out is free within ${SITE.freeCalloutMiles} road miles of Goole; further out, the travel is quoted before we set off.`}
    crumbs={[{ label: 'Areas' }]}
  />

  <section class="band">
    <div class="wrap grid items-center gap-x-16 gap-y-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,0.85fr)]">
      <div>
        <h2 class="t-h2">Up to {SITE.operatingMiles} miles from Goole</h2>
        <p class="t-lead mt-3 max-w-xl">Everywhere in blue, we come to you. In the yellow zone around Goole the call-out is free; anywhere else in blue, we quote the travel by phone before we set off.</p>
        <p class="mt-6 t-ui"><a href={`tel:${SITE.phoneTel}`} class="link num">Not sure if you are in range? Call {SITE.phoneDisplay}</a></p>
      </div>
      <CoverageMap class="mx-auto w-full max-w-[26rem]" />
    </div>
  </section>

  <section class="band bg-surface">
    <div class="wrap grid gap-x-14 gap-y-12 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)]">
      <div>
        <h2 class="t-h3 mb-3">Towns with their own page</h2>
        <table class="w-full border-collapse text-left">
          <caption class="sr-only">Road miles from Goole and call-out terms</caption>
          <thead>
            <tr class="border-b-[3px] border-ink"><th scope="col" class="t-label py-2.5">Town</th><th scope="col" class="t-label py-2.5 text-right">Miles</th><th scope="col" class="t-label py-2.5 text-right">Call-out</th></tr>
          </thead>
          <tbody>
            {sorted.map((a) => (
              <tr class="border-b border-line">
                <th scope="row" class="py-3.5 pr-3"><a href={`/areas/${a.slug}`} class="link text-[1.125rem]">{a.name}</a></th>
                <td class="num py-3.5 text-right font-bold">{a.roadMiles === 0 ? 'Base' : a.roadMiles}</td>
                <td class="py-3.5 pl-3 text-right">{a.free ? <span class="tag-free">FREE</span> : <span class="tag-quoted">QUOTED</span>}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div>
        <h2 class="t-h3 mb-3">Places in range, by region</h2>
        <div class="grid gap-x-8 gap-y-8 sm:grid-cols-2 xl:grid-cols-3">
          {REACH.map((r) => (
            <div>
              <h3 class="t-label mb-2">{r.region}</h3>
              <ul class="border-t-[3px] border-ink">
                {r.places.map((p) => <li class="border-b border-line py-2 t-ui font-bold">{p}</li>)}
              </ul>
            </div>
          ))}
        </div>
        <p class="mt-8 t-ui">{SITE.coverage.secondary}.</p>
      </div>
    </div>
  </section>

  <CallBand />
</BaseLayout>
