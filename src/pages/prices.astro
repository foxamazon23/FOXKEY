---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import PriceBoard from '../components/PriceBoard.astro';
import ProofNotice from '../components/ProofNotice.astro';
import CallBand from '../components/CallBand.astro';
import { SEO, SITE, HGV_SERVICES, HGV_CALLOUT, HGV_PRICE_NOTE, GENERAL_PRICE_NOTE, WARRANTY_TEXT, PRICES_INCLUDE_VAT, FLEET } from '../config/site';
---
<BaseLayout title={SEO.prices.title} description={SEO.prices.description}>
  <PageHead
    title="HGV prices"
    lead="Starting prices for every lorry job. The exact figure depends on make, model and year, and we confirm it by phone before we travel."
    crumbs={[{ label: 'Prices' }]}
  />

  <section class="band">
    <div class="wrap grid gap-x-14 gap-y-10 lg:grid-cols-[minmax(0,1fr)_20rem]">
      <div>
        <PriceBoard services={HGV_SERVICES} base="/hgv" caption="HGV and lorry starting prices" callout={{ title: `${HGV_CALLOUT.title}, within ${SITE.freeCalloutMiles} miles of Goole`, text: 'Free' }} />
        <p class="mt-5 measure t-ui">{HGV_PRICE_NOTE}</p>
        <p class="mt-3 measure t-ui">{GENERAL_PRICE_NOTE}</p>
      </div>
      <aside class="space-y-6 lg:sticky lg:top-28 lg:self-start">
        <div class="panel p-5">
          <h2 class="font-extrabold">VAT</h2>
          <p class="mt-1 t-ui text-muted">{PRICES_INCLUDE_VAT ? 'Prices include VAT.' : 'Prices are shown before VAT. VAT is added at the current rate.'}</p>
          <h2 class="mt-5 font-extrabold">Paying</h2>
          <p class="mt-1 t-ui text-muted">{SITE.payment.join(', ')}. For key work you pay once the lorry starts.</p>
          <h2 class="mt-5 font-extrabold">Warranty</h2>
          <p class="mt-1 t-ui text-muted">{WARRANTY_TEXT}</p>
          <h2 class="mt-5 font-extrabold">Running a fleet?</h2>
          <p class="mt-1 t-ui text-muted">Account rates and monthly invoicing. <a href={FLEET.cta.href} class="link">Fleet enquiry</a></p>
        </div>
        <ProofNotice headingLevel="h2" />
      </aside>
    </div>
  </section>

  <CallBand title="Want the exact price?" text="Ring or WhatsApp with the make, the registration and where the lorry is. You get the figure before we set off." />
</BaseLayout>
