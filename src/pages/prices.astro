---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import PriceLedger from '../components/PriceLedger.astro';
import ProofNotice from '../components/ProofNotice.astro';
import CallBand from '../components/CallBand.astro';
import Icon from '../components/Icon.astro';
import { SEO, SITE, CAR_SERVICES, CAR_CALLOUT, HGV_SERVICES, HGV_CALLOUT, HGV_PRICE_NOTE, GENERAL_PRICE_NOTE, VAT_LABEL, WARRANTY_TEXT } from '../config/site';
---
<BaseLayout title={SEO.prices.title} description={SEO.prices.description}>
  <PageHead title="Prices, agreed on the phone before we travel" lead={`Every figure is a starting price, ${VAT_LABEL}. Your make, model and year set the final price, and we tell you what it is before we set off.`} crumbs={[{ label: 'Prices' }]} />

  <section class="band-sm">
    <div class="wrap max-w-4xl">
      <div role="tablist" aria-label="Price lists" class="inline-flex gap-1 rounded-md border border-line bg-surface p-1">
        <button role="tab" id="tab-cars" aria-selected="true" aria-controls="panel-cars" class="price-tab inline-flex min-h-11 items-center gap-2 rounded-[10px] px-4 t-ui font-bold text-muted aria-selected:bg-raised aria-selected:text-ink"><Icon name="car" class="h-4 w-4" />Cars &amp; Vans</button>
        <button role="tab" id="tab-hgv" aria-selected="false" aria-controls="panel-hgv" tabindex="-1" class="price-tab inline-flex min-h-11 items-center gap-2 rounded-[10px] px-4 t-ui font-bold text-muted aria-selected:bg-raised aria-selected:text-ink"><Icon name="truck" class="h-4 w-4" />HGV &amp; Lorries</button>
      </div>
      <div id="panel-cars" role="tabpanel" aria-labelledby="tab-cars" tabindex="0" class="price-panel mt-8">
        <h2 class="sr-only">Cars and vans</h2>
        <PriceLedger services={CAR_SERVICES} base="/services" callout={CAR_CALLOUT} caption="Car and van prices" />
        <p class="mt-5 t-small">{GENERAL_PRICE_NOTE}</p>
      </div>
      <div id="panel-hgv" role="tabpanel" aria-labelledby="tab-hgv" tabindex="0" class="price-panel mt-8" hidden>
        <h2 id="hgv" class="sr-only">HGV and lorries</h2>
        <PriceLedger services={HGV_SERVICES} base="/hgv" callout={HGV_CALLOUT} caption="HGV and lorry prices" />
        <p class="mt-5 t-small">{HGV_PRICE_NOTE}</p>
      </div>

      <dl class="mt-14 grid gap-x-10 sm:grid-cols-2">
        <div class="border-t border-line py-5"><dt class="font-bold text-ink">Call-out</dt><dd class="mt-1 t-small">Free within {SITE.freeCalloutMiles} miles of Goole. Further out, the trip is quoted upfront.</dd></div>
        <div class="border-t border-line py-5"><dt class="font-bold text-ink">Paying</dt><dd class="mt-1 t-small">{SITE.payment.join(', ')}. For key work you pay once the vehicle starts.</dd></div>
        <div class="border-t border-line py-5"><dt class="font-bold text-ink">VAT</dt><dd class="mt-1 t-small">Prices are shown {VAT_LABEL}.</dd></div>
        <div class="border-t border-line py-5"><dt class="font-bold text-ink">Warranty</dt><dd class="mt-1 t-small">{WARRANTY_TEXT}</dd></div>
      </dl>
      <ProofNotice class="mt-8" />
    </div>
  </section>

  <CallBand title="Want the exact figure?" text="Give us the make, model and year and we will tell you on the call." />

  <script>
    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.price-tab'));
    const panels = Array.from(document.querySelectorAll<HTMLElement>('.price-panel'));
    const show = (tab: HTMLButtonElement, focus = false) => {
      tabs.forEach((t) => { const on = t === tab; t.setAttribute('aria-selected', String(on)); t.tabIndex = on ? 0 : -1; });
      panels.forEach((p) => { p.hidden = p.id !== tab.getAttribute('aria-controls'); });
      if (focus) tab.focus();
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => show(tab));
      tab.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') show(tabs[(i + 1) % tabs.length], true);
        if (e.key === 'ArrowLeft') show(tabs[(i - 1 + tabs.length) % tabs.length], true);
      });
    });
    if (['#hgv', '#panel-hgv'].includes(location.hash)) show(tabs[1]);
  </script>
</BaseLayout>
