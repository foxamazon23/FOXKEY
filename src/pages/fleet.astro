---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import FormShell from '../components/FormShell.astro';
import Icon from '../components/Icon.astro';
import { SEO, SITE, FLEET, enabledTruckMakes, enabledVanMakes } from '../config/site';
---
<BaseLayout title={SEO.fleet.title} description={SEO.fleet.description}>
  <PageHead title="Fleet and operator accounts" lead={FLEET.intro} crumbs={[{ label: 'HGV & Lorries', href: '/hgv' }, { label: 'Fleet enquiry' }]} />
  <section class="band-sm">
    <div class="wrap grid gap-x-14 gap-y-10 lg:grid-cols-[minmax(0,1.5fr)_minmax(0,1fr)]">
      <FormShell id="fleet-form" subject="New fleet enquiry from the FoxKey website" submitLabel="Send fleet enquiry">
        <div class="grid gap-5 sm:grid-cols-2">
          <div class="sm:col-span-2"><label for="company" class="label">Company name</label><input id="company" name="company" class="field" required autocomplete="organization" /></div>
          <div>
            <label for="fleet_size" class="label">Fleet size</label>
            <select id="fleet_size" name="fleet_size" class="field" required>
              <option value="">Choose</option>
              {['1 to 5 vehicles', '6 to 20 vehicles', '21 to 50 vehicles', '51 to 100 vehicles', 'More than 100'].map((o) => <option value={o}>{o}</option>)}
            </select>
          </div>
          <div>
            <label for="fleet_type" class="label">Vehicle types</label>
            <select id="fleet_type" name="fleet_type" class="field" required>
              <option value="">Choose</option>
              {['Lorries and HGVs', 'Vans and light commercials', 'Mixed fleet', 'Cars', 'Other'].map((o) => <option value={o}>{o}</option>)}
            </select>
          </div>
          <div class="sm:col-span-2"><label for="makes" class="label">Makes in the fleet</label><input id="makes" name="makes" class="field" placeholder="Mercedes Actros, Ford Transit, VW Crafter" required /></div>
          <div><label for="contact_name" class="label">Contact name</label><input id="contact_name" name="contact_name" class="field" required autocomplete="name" /></div>
          <div><label for="fleet_phone" class="label">Phone</label><input id="fleet_phone" name="phone" type="tel" class="field num" required autocomplete="tel" /></div>
          <div class="sm:col-span-2"><label for="depot" class="label">Depot or yard <span class="opt">(optional)</span></label><input id="depot" name="depot_location" class="field" placeholder="Town or postcode" /></div>
          <div class="sm:col-span-2"><label for="fleet_message" class="label">Anything else? <span class="opt">(optional)</span></label><textarea id="fleet_message" name="message" rows="4" class="field" placeholder="Typical jobs, hours, how you want to be invoiced"></textarea></div>
        </div>
      </FormShell>
      <aside class="space-y-8">
        <dl>
          {FLEET.benefits.map((b) => <div class="border-t border-line py-4"><dt class="font-bold text-ink">{b.title}</dt><dd class="mt-1 t-small">{b.text}</dd></div>)}
        </dl>
        <div>
          <h2 class="t-label mb-2">Makes we cover today</h2>
          <p class="t-small">{[...enabledTruckMakes(), ...enabledVanMakes()].map((m) => m.name).join(', ')}.</p>
        </div>
        <a href={`tel:${SITE.phoneTel}`} class="btn btn-quiet num w-full"><Icon name="phone" class="h-5 w-5" />{SITE.phoneDisplay}</a>
      </aside>
    </div>
  </section>
</BaseLayout>
