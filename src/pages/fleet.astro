---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import FormShell from '../components/FormShell.astro';
import Icon from '../components/Icon.astro';
import { SEO, SITE, FLEET, OWNERSHIP_PROOF } from '../config/site';
---
<BaseLayout title={SEO.fleet.title} description={SEO.fleet.description}>
  <PageHead title={FLEET.title} lead={FLEET.intro} crumbs={[{ label: 'Fleet enquiry' }]} />

  <section class="band">
    <div class="wrap">
      <h2 class="t-h2">What an account gives you</h2>
      <ul class="mt-8 grid gap-x-8 sm:grid-cols-2 lg:grid-cols-4">
        {FLEET.benefits.map((b) => (
          <li class="border-t-[3px] border-ink py-5">
            <h3 class="font-extrabold">{b.title}</h3>
            <p class="mt-1 t-ui text-muted">{b.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="band bg-surface">
    <div class="wrap grid gap-x-16 gap-y-12 lg:grid-cols-[minmax(0,1fr)_22rem]">
      <div class="rounded-md bg-paper p-5 sm:p-8">
        <h2 class="t-h2 mb-2">Fleet enquiry</h2>
        <p class="t-body mb-8">We call you back to set up the account. For a vehicle off the road right now, ring instead.</p>
        <FormShell id="fleet-form" subject="New fleet enquiry from foxkeyauto.co.uk" submitLabel="Send fleet enquiry">
          <div class="grid gap-6 sm:grid-cols-2">
            <div><label for="f-company" class="label">Company or operator name</label><input id="f-company" name="company" class="field" required autocomplete="organization" /></div>
            <div><label for="f-name" class="label">Your name</label><input id="f-name" name="name" class="field" required autocomplete="name" /></div>
            <div><label for="f-phone" class="label">Phone number</label><input id="f-phone" name="phone" type="tel" class="field num" required autocomplete="tel" /></div>
            <div><label for="f-email" class="label">Email <span class="opt">(optional)</span></label><input id="f-email" name="email" type="email" class="field" autocomplete="email" /></div>
          </div>
          <div class="grid gap-6 sm:grid-cols-2">
            <div><label for="f-size" class="label">Number of lorries</label><input id="f-size" name="fleet_size" class="field num" inputmode="numeric" required placeholder="12" /></div>
            <div><label for="f-depot" class="label">Depot location</label><input id="f-depot" name="depot" class="field" required placeholder="Town or postcode" /></div>
          </div>
          <div><label for="f-message" class="label">Makes, current problems or anything else <span class="opt">(optional)</span></label><textarea id="f-message" name="message" rows="4" class="field"></textarea></div>
        </FormShell>
      </div>
      <aside class="space-y-6 lg:sticky lg:top-28 lg:self-start">
        <div>
          <h2 class="font-extrabold">Vehicle off the road?</h2>
          <p class="mt-1 t-ui text-muted">Ring at any hour. Account or not, we can come out.</p>
          <a href={`tel:${SITE.phoneTel}`} class="btn btn-call num mt-4 w-full"><Icon name="phone" class="h-5 w-5" />Call {SITE.phoneDisplay}</a>
        </div>
        <div class="border-t-[3px] border-ink pt-5">
          <h2 class="font-extrabold">Authorisation for fleet vehicles</h2>
          <p class="mt-1 t-ui text-muted">{OWNERSHIP_PROOF.text}</p>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
