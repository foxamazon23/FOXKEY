---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import PhotoSlot from '../components/PhotoSlot.astro';
import ProofNotice from '../components/ProofNotice.astro';
import CallBand from '../components/CallBand.astro';
import { SEO, SITE, WHY_FOXKEY, WARRANTY_TEXT } from '../config/site';
---
<BaseLayout title={SEO.about.title} description={SEO.about.description}>
  <PageHead
    title="A mobile locksmith for lorries, based in Goole"
    lead={`${SITE.name} cuts and programmes keys, repairs cab remotes and diagnoses faults at the lorry, for owner-drivers and haulage operators across Yorkshire and the Humber.`}
    crumbs={[{ label: 'About' }]}
    long
  />

  <section class="band">
    <div class="wrap grid gap-x-16 gap-y-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,0.9fr)]">
      <div class="prose-fk">
        <h2>Why a mobile service</h2>
        <p>A lorry that will not start on a yard, or a driver who has lost the only key at a lorry park, usually means heavy recovery and days at a truck dealer. Most of that work can be done where the lorry stands, so that is where we do it.</p>
        <p>We work on lorries and HGVs only. The van carries truck key blanks, remotes, cutting equipment and diagnostic tools. {SITE.equipmentGeneric}</p>
        <h2>Where we work</h2>
        <p>{SITE.baseDescription} We cover {SITE.coverage.primary}, with a free call-out within {SITE.freeCalloutMiles} miles of Goole. {SITE.coverage.secondary}.</p>
        <p>We do not publish a street address because we do not have a workshop to visit. Every job happens at your lorry.</p>
        <h2>How we work</h2>
        <p>We confirm the price by phone before we travel. Before any key or module work we check proof of ownership, and for key work you pay once the lorry starts. Fleet accounts are invoiced monthly.</p>
        <p>Warranty: {WARRANTY_TEXT}</p>
      </div>
      <div class="space-y-6">
        <PhotoSlot label="the FoxKey van" ratio="aspect-[4/3]" />
        <ProofNotice headingLevel="h2" />
      </div>
    </div>
  </section>

  <section class="band bg-surface">
    <div class="wrap">
      <h2 class="t-h2">What you can count on</h2>
      <ul class="mt-8 grid gap-x-8 sm:grid-cols-2 lg:grid-cols-5">
        {WHY_FOXKEY.map((w) => (
          <li class="border-t-[3px] border-ink py-5">
            <h3 class="font-extrabold">{w.title}</h3>
            <p class="mt-1 t-ui text-muted">{w.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CallBand />
</BaseLayout>
