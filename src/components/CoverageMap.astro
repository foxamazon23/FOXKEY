---
/**
 * Coverage map: Great Britain in light grey, the land within SITE.operatingMiles of Goole in solid sign blue,
 * the free call-out zone in yellow. Everything is clipped to the coastline, so nothing spills into the sea.
 * Outline: Natural Earth 1:10m (public domain), built by scripts/build-coverage-map.mjs into src/data/coverage-map.json.
 */
import MAP from '../data/coverage-map.json';
import { SITE } from '../config/site';
interface Props { class?: string; id?: string }
const { class: className = '', id = 'map' } = Astro.props;

const { view, lat0, w: W, h: H, k } = MAP;
const cos = Math.cos((lat0 * Math.PI) / 180);
const P = (lat: number, lng: number) => [+((lng - view.lonMin) * cos * k).toFixed(1), +((view.latMax - lat) * k).toFixed(1)];
const mi = (miles: number) => (miles / 69.05) * k;
const [gx, gy] = P(SITE.mapCoords.lat, SITE.mapCoords.lng);
const reach = mi(SITE.operatingMiles), free = mi(SITE.freeCalloutMiles);

type Place = { name: string; lat: number; lng: number; dx: number; dy: number; anchor?: 'start' | 'end' | 'middle' };
// inside the area: white on blue
const inside: Place[] = [
  { name: 'Middlesbrough', lat: 54.574, lng: -1.235, dx: -8, dy: 5, anchor: 'end' },
  { name: 'Leeds', lat: 53.801, lng: -1.549, dx: -8, dy: -6, anchor: 'end' },
  { name: 'Manchester', lat: 53.481, lng: -2.243, dx: 0, dy: -9, anchor: 'middle' },
  { name: 'Liverpool', lat: 53.408, lng: -2.992, dx: 6, dy: 18 },
  { name: 'Sheffield', lat: 53.381, lng: -1.47, dx: 0, dy: 19, anchor: 'middle' },
  { name: 'Lincoln', lat: 53.231, lng: -0.541, dx: 8, dy: 5 },
  { name: 'Nottingham', lat: 52.955, lng: -1.158, dx: -8, dy: 5, anchor: 'end' },
];
// outside the area, for orientation: grey
const outside: Place[] = [
  { name: 'Edinburgh', lat: 55.953, lng: -3.188, dx: 8, dy: 5 },
  { name: 'Cardiff', lat: 51.481, lng: -3.179, dx: 8, dy: 5 },
  { name: 'London', lat: 51.507, lng: -0.128, dx: 8, dy: 5 },
];
const pill = (() => { const b = (300 * Math.PI) / 180; return [gx + Math.sin(b) * reach, gy - Math.cos(b) * reach]; })();
---
<figure class={className}>
  <svg viewBox={`0 0 ${W} ${H}`} class="block h-auto w-full" role="img" aria-labelledby={`${id}-t ${id}-d`}>
    <title id={`${id}-t`}>Where FoxKey HGV covers: up to {SITE.operatingMiles} miles from {SITE.baseTown}</title>
    <desc id={`${id}-d`}>A map of Great Britain. The land within {SITE.operatingMiles} miles of Goole is shaded blue: it takes in Leeds, York, Hull, Sheffield, Manchester, Liverpool, Middlesbrough, Lincoln and Nottingham. A yellow area within {SITE.freeCalloutMiles} miles of Goole, including Hull, is the free call-out zone. Edinburgh, Cardiff and London are outside the area.</desc>
    <defs><clipPath id={`${id}-gb`}><path d={MAP.land} /></clipPath></defs>
    <path d={MAP.land} fill="#E3E6E9" />
    <g clip-path={`url(#${id}-gb)`}>
      <circle cx={gx} cy={gy} r={reach} fill="#0B4EA2" />
      <circle cx={gx} cy={gy} r={free} fill="#FFD500" stroke="#FFFFFF" stroke-width="2" />
    </g>
    {outside.map((c) => { const [x, y] = P(c.lat, c.lng); return (
      <g class="map-minor">
        <circle cx={x} cy={y} r="3.5" fill="#6B7377" />
        <text x={x + c.dx} y={y + c.dy} text-anchor={c.anchor ?? 'start'} fill="#4B5357" font-size="15" font-weight="700">{c.name}</text>
      </g>
    ); })}
    {inside.map((c) => { const [x, y] = P(c.lat, c.lng); return (
      <g>
        <circle cx={x} cy={y} r="3.5" fill="#FFFFFF" />
        <text x={x + c.dx} y={y + c.dy} text-anchor={c.anchor ?? 'start'} fill="#FFFFFF" font-size="15" font-weight="800" paint-order="stroke" stroke="#0B4EA2" stroke-width="3" stroke-linejoin="round">{c.name}</text>
      </g>
    ); })}
    <circle cx={gx} cy={gy} r="6" fill="#0B0C0C" stroke="#FFFFFF" stroke-width="2.5" />
    <text x={gx} y={gy + 22} text-anchor="middle" fill="#0B0C0C" font-size="16" font-weight="900">Goole</text>
    <g transform={`translate(${pill[0]} ${pill[1]})`}>
      <rect x="-50" y="-13" width="100" height="26" rx="13" fill="#FFFFFF" stroke="#0B4EA2" stroke-width="2.5" />
      <text x="0" y="5" text-anchor="middle" fill="#0B4EA2" font-size="14" font-weight="900">{SITE.operatingMiles} MILES</text>
    </g>
  </svg>
  <figcaption class="mt-4 flex flex-wrap gap-x-6 gap-y-2 t-ui">
    <span class="inline-flex items-center gap-2"><span class="inline-block h-4 w-6 rounded-sm bg-sign"></span>We come to you: up to {SITE.operatingMiles} miles</span>
    <span class="inline-flex items-center gap-2"><span class="inline-block h-4 w-6 rounded-sm bg-plate"></span>Free call-out: up to {SITE.freeCalloutMiles} miles</span>
  </figcaption>
</figure>
<style>
  @media (max-width: 639px) {
    figure :global(.map-minor) { display: none; }
  }
</style>
