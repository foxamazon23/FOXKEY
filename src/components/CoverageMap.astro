---
/**
 * Static coverage map drawn to scale from real town coordinates (latitude-corrected equirectangular projection).
 * Roads and the Humber are simplified polylines through approximate real points, labelled as schematic.
 */
import { AREAS, SITE } from '../config/site';
interface Props { class?: string; id?: string }
const { class: className = '', id = 'map' } = Astro.props;
const lon0 = -1.68, lon1 = -0.22, lat0 = 54.03, lat1 = 53.44;
const cosLat = Math.cos((53.73 * Math.PI) / 180);
const W = 640;
const k = W / ((lon1 - lon0) * cosLat);
const H = Math.round((lat0 - lat1) * k);
const P = (lat: number, lng: number) => [+((lng - lon0) * cosLat * k).toFixed(1), +((lat0 - lat) * k).toFixed(1)];
const line = (pts: number[][]) => 'M' + pts.map(([la, ln]) => P(la, ln).join(' ')).join(' L');
const water = [[53.705, -0.87], [53.7, -0.78], [53.7, -0.7], [53.715, -0.6], [53.72, -0.5], [53.735, -0.4], [53.725, -0.3], [53.7, -0.22]];
const roads = [
  { name: 'M62', pts: [[53.745, -1.62], [53.733, -1.57], [53.725, -1.51], [53.72, -1.43], [53.7, -1.34], [53.7, -1.25], [53.69, -1.1], [53.675, -0.98], [53.7, -0.885], [53.745, -0.86], [53.765, -0.69], [53.74, -0.55], [53.735, -0.42], [53.743, -0.34]], label: [53.715, -1.42, 0, 26] },
  { name: 'M18', pts: [[53.675, -0.98], [53.62, -0.97], [53.585, -0.985], [53.55, -1.06], [53.51, -1.1], [53.47, -1.17]], label: [53.56, -1.04, -38, 0] },
  { name: 'M180', pts: [[53.585, -0.985], [53.58, -0.85], [53.575, -0.7], [53.57, -0.62]], label: [53.578, -0.8, -20, 26] },
  { name: 'A1(M)', pts: [[53.47, -1.17], [53.52, -1.18], [53.6, -1.22], [53.7, -1.25], [53.8, -1.3], [53.9, -1.33], [54.0, -1.35]], label: [53.93, -1.34, -58, 0] },
];
const offsets: Record<string, { dx: number; dy: number; anchor: 'start' | 'end' }> = {
  goole: { dx: 22, dy: 6, anchor: 'start' }, selby: { dx: -14, dy: -10, anchor: 'end' }, leeds: { dx: 14, dy: -14, anchor: 'start' },
  york: { dx: 14, dy: 6, anchor: 'start' }, doncaster: { dx: 14, dy: 14, anchor: 'start' }, scunthorpe: { dx: 14, dy: 16, anchor: 'start' }, hull: { dx: -14, dy: -24, anchor: 'end' },
};
const towns = AREAS.map((a) => ({ ...a, xy: P(a.lat, a.lng), o: offsets[a.slug] ?? { dx: 14, dy: 6, anchor: 'start' as const } }));
const tenMiles = (10 / 69.05) * k;
---
<figure class={className}>
  <svg viewBox={`0 0 ${W} ${H}`} class="block h-auto w-full rounded-md bg-sign-soft" role="img" aria-labelledby={`${id}-t ${id}-d`}>
    <title id={`${id}-t`}>Where FoxKey covers from {SITE.baseTown}</title>
    <desc id={`${id}-d`}>{towns.map((t) => `${t.name}: ${t.slug === 'goole' ? 'our base' : `about ${t.roadMiles} road miles, ${t.free ? 'free call-out' : 'travel quoted upfront'}`}`).join('. ')}.</desc>
    <path d={line(water)} fill="none" stroke="#9DB8D6" stroke-width="9" stroke-linecap="round" stroke-linejoin="round" />
    {roads.map((r) => <path d={line(r.pts)} fill="none" stroke="#0B4EA2" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />)}
    {roads.map((r) => { const [x, y] = P(r.label[0], r.label[1]); return (
      <g class="map-minor" transform={`translate(${x + r.label[2]} ${y + r.label[3]})`}>
        <rect x="-4" y="-15" width={r.name.length * 11 + 8} height="21" rx="3" fill="#0B4EA2" />
        <text x="0" y="1" fill="#FFFFFF" font-size="15" font-weight="900">{r.name}</text>
      </g>
    ); })}
    {towns.map((t) => (
      <g>
        {t.slug === 'goole'
          ? <circle cx={t.xy[0]} cy={t.xy[1]} r="10" fill="#FFD500" stroke="#0B0C0C" stroke-width="3" />
          : <circle cx={t.xy[0]} cy={t.xy[1]} r="7" fill={t.free ? '#0B0C0C' : '#FFFFFF'} stroke="#0B0C0C" stroke-width="3" />}
        <text x={t.xy[0] + t.o.dx} y={t.xy[1] + t.o.dy} text-anchor={t.o.anchor} fill="#0B0C0C" font-size={t.slug === 'goole' ? 24 : 20} font-weight="900" class="map-town">{t.name}</text>
        <text x={t.xy[0] + t.o.dx} y={t.xy[1] + t.o.dy + 19} text-anchor={t.o.anchor} fill="#4B5357" font-size="15" font-weight="700" class="map-minor num">{t.slug === 'goole' ? 'Our base' : `${t.roadMiles} mi`}</text>
      </g>
    ))}
    <g class="map-minor" transform={`translate(18 ${H - 22})`} fill="#0B0C0C" font-size="14" font-weight="800">
      <path d={`M0 0 H${tenMiles.toFixed(1)} M0 -5 V5 M${tenMiles.toFixed(1)} -5 V5`} stroke="#0B0C0C" stroke-width="2.5" />
      <text x={tenMiles + 8} y="5">10 miles</text>
    </g>
  </svg>
  <figcaption class="mt-3 flex flex-wrap items-center gap-x-5 gap-y-2 t-small">
    <span class="inline-flex items-center gap-2"><svg width="14" height="14" aria-hidden="true"><circle cx="7" cy="7" r="5" fill="#0B0C0C" stroke="#0B0C0C" stroke-width="2" /></svg>Free call-out</span>
    <span class="inline-flex items-center gap-2"><svg width="14" height="14" aria-hidden="true"><circle cx="7" cy="7" r="5" fill="#FFFFFF" stroke="#0B0C0C" stroke-width="2" /></svg>Travel quoted upfront</span>
    <span>Schematic: towns to scale, roads simplified.</span>
  </figcaption>
</figure>
<style>
  @media (max-width: 639px) {
    figure :global(.map-minor) { display: none; }
    figure :global(.map-town) { font-size: 30px; }
  }
</style>
