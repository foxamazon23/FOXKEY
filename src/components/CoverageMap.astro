---
/**
 * Coverage map: everywhere up to SITE.operatingMiles from Goole, with the free call-out zone.
 * Coastline: Natural Earth 1:10m land (public domain), built by scripts/build-coverage-map.mjs into
 * src/data/coverage-map.json. Towns are placed from real coordinates; motorways are simplified.
 */
import MAP from '../data/coverage-map.json';
import { AREAS, SITE } from '../config/site';
interface Props { class?: string; id?: string }
const { class: className = '', id = 'map' } = Astro.props;

const { view, lat0, w: W, h: H, k } = MAP;
const cos = Math.cos((lat0 * Math.PI) / 180);
const P = (lat: number, lng: number) => [+((lng - view.lonMin) * cos * k).toFixed(1), +((view.latMax - lat) * k).toFixed(1)];
const line = (pts: number[][]) => 'M' + pts.map(([la, ln]) => P(la, ln).join(' ')).join(' L');
const mi = (miles: number) => (miles / 69.05) * k;   // miles to map units (1° of latitude ≈ 69 miles)

const [gx, gy] = P(SITE.mapCoords.lat, SITE.mapCoords.lng);
const reach = mi(SITE.operatingMiles), mid = mi(50), free = mi(SITE.freeCalloutMiles);
// ring labels sit on each band's edge, south-west of Goole where the edge is over land
const ringLabel = (r: number, deg: number) => { const b = (deg * Math.PI) / 180; return [gx + Math.sin(b) * r, gy - Math.cos(b) * r]; };
const rings = [{ r: mid, t: '50 mi', deg: 150 }, { r: reach, t: `${SITE.operatingMiles} mi`, deg: 235 }];

const roads = [
  { name: 'M62', pts: [[53.405, -2.95], [53.4, -2.6], [53.52, -2.33], [53.58, -2.1], [53.66, -1.85], [53.72, -1.63], [53.7, -1.35], [53.69, -1.1], [53.675, -0.98], [53.7, -0.885], [53.745, -0.86], [53.765, -0.69], [53.74, -0.45], [53.745, -0.34]], at: [53.6, -2.05] },
  { name: 'M1', pts: [[52.2, -1.1], [52.4, -1.17], [52.62, -1.2], [52.93, -1.27], [53.05, -1.3], [53.25, -1.33], [53.4, -1.38], [53.55, -1.47], [53.7, -1.5], [53.76, -1.52]], at: [52.75, -1.22] },
  { name: 'A1(M)', pts: [[51.9, -0.2], [52.57, -0.27], [52.92, -0.64], [53.08, -0.81], [53.33, -0.97], [53.47, -1.12], [53.55, -1.2], [53.71, -1.25], [53.93, -1.38], [54.22, -1.48], [54.44, -1.66], [54.7, -1.58], [54.96, -1.62], [55.4, -1.7]], at: [54.25, -1.48] },
  { name: 'M6', pts: [[52.25, -1.4], [52.52, -1.85], [52.68, -2.03], [53.0, -2.22], [53.25, -2.4], [53.4, -2.55], [53.55, -2.62], [53.76, -2.68], [54.05, -2.78], [54.35, -2.7], [54.66, -2.75], [54.89, -2.93], [55.2, -3.05]], at: [54.3, -2.71] },
  { name: 'M18', pts: [[53.675, -0.98], [53.58, -0.99], [53.52, -1.07], [53.42, -1.25]], at: [] },
  { name: 'M180', pts: [[53.585, -0.99], [53.575, -0.7], [53.57, -0.55], [53.58, -0.3], [53.57, -0.08]], at: [] },
];
// Major places inside the radius (the REACH list in site.ts); the seven towns with their own page are drawn smaller
const cities: { name: string; lat: number; lng: number; dx: number; dy: number; anchor?: 'start' | 'end' | 'middle'; minor?: boolean }[] = [
  { name: 'Durham', lat: 54.776, lng: -1.575, dx: 10, dy: 5 },
  { name: 'Darlington', lat: 54.523, lng: -1.553, dx: -10, dy: 5, anchor: 'end', minor: true },
  { name: 'Middlesbrough', lat: 54.574, lng: -1.235, dx: 10, dy: 5 },
  { name: 'Harrogate', lat: 53.992, lng: -1.541, dx: -10, dy: 5, anchor: 'end', minor: true },
  { name: 'Preston', lat: 53.763, lng: -2.703, dx: -10, dy: 5, anchor: 'end' },
  { name: 'Liverpool', lat: 53.408, lng: -2.992, dx: 0, dy: -11, anchor: 'middle' },
  { name: 'Manchester', lat: 53.481, lng: -2.243, dx: 0, dy: 21, anchor: 'middle' },
  { name: 'Bradford', lat: 53.795, lng: -1.759, dx: -10, dy: -5, anchor: 'end', minor: true },
  { name: 'Sheffield', lat: 53.381, lng: -1.47, dx: 9, dy: 15 },
  { name: 'Chesterfield', lat: 53.235, lng: -1.421, dx: -10, dy: 5, anchor: 'end', minor: true },
  { name: 'Nottingham', lat: 52.955, lng: -1.158, dx: 10, dy: 5 },
  { name: 'Derby', lat: 52.923, lng: -1.475, dx: -10, dy: 12, anchor: 'end' },
  { name: 'Leicester', lat: 52.637, lng: -1.14, dx: 10, dy: 5 },
  { name: 'Lincoln', lat: 53.231, lng: -0.541, dx: 10, dy: 5 },
  { name: 'Grimsby', lat: 53.568, lng: -0.08, dx: 10, dy: 5 },
  { name: 'Boston', lat: 52.979, lng: -0.027, dx: 10, dy: 5 },
];
const towns = AREAS.filter((a) => a.slug !== 'goole').map((a) => ({ ...a, xy: P(a.lat, a.lng) }));
const townLabel: Record<string, { dx: number; dy: number; anchor: 'start' | 'end' | 'middle' }> = {
  leeds: { dx: 0, dy: 18, anchor: 'middle' }, york: { dx: 8, dy: -6, anchor: 'start' }, selby: { dx: -8, dy: -7, anchor: 'end' },
  hull: { dx: 9, dy: -6, anchor: 'start' }, doncaster: { dx: -9, dy: 12, anchor: 'end' }, scunthorpe: { dx: 0, dy: 18, anchor: 'middle' },
};
const scale = mi(25);
---
<figure class={className}>
  <svg viewBox={`0 0 ${W} ${H}`} class="block h-auto w-full rounded-md" role="img" aria-labelledby={`${id}-t ${id}-d`}>
    <title id={`${id}-t`}>Where FoxKey HGV covers: up to {SITE.operatingMiles} miles from {SITE.baseTown}</title>
    <desc id={`${id}-d`}>A map of northern England and the East Midlands with the land shaded by distance from Goole. Yellow, the free call-out zone within {SITE.freeCalloutMiles} miles, covers Selby, Doncaster and Scunthorpe. Darker blue, within 50 miles, takes in Leeds, York, Hull, Sheffield, Lincoln and Grimsby. Lighter blue, within {SITE.operatingMiles} miles, reaches Durham, Middlesbrough, Preston, Liverpool, Manchester, Nottingham, Derby, Leicester and Boston. Land beyond that is left white.</desc>
    <defs>
      <clipPath id={`${id}-frame`}><rect width={W} height={H} rx="8" /></clipPath>
      <clipPath id={`${id}-land`}><path d={MAP.land} /></clipPath>
    </defs>
    <g clip-path={`url(#${id}-frame)`}>
      <rect width={W} height={H} fill="#DCE6F1" />
      <path d={MAP.land} fill="#FFFFFF" />
      <g clip-path={`url(#${id}-land)`}>
        <circle cx={gx} cy={gy} r={reach} fill="#DCE8F7" />
        <circle cx={gx} cy={gy} r={mid} fill="#BFD4EF" stroke="#FFFFFF" stroke-width="2.5" />
        <circle cx={gx} cy={gy} r={free} fill="#FFE27A" stroke="#FFFFFF" stroke-width="2.5" />
        <circle cx={gx} cy={gy} r={reach} fill="none" stroke="#0B4EA2" stroke-width="2.5" />
      </g>
      <path d={MAP.land} fill="none" stroke="#9DB8D6" stroke-width="1.2" stroke-linejoin="round" />
      {roads.map((r) => <path d={line(r.pts)} fill="none" stroke="#0B4EA2" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" stroke-opacity="0.7" />)}
      {roads.filter((r) => r.at.length).map((r) => { const [x, y] = P(r.at[0], r.at[1]); return (
        <g class="map-minor" transform={`translate(${x} ${y})`}>
          <rect x={-(r.name.length * 5.4 + 5)} y="-10" width={r.name.length * 10.8 + 10} height="19" rx="3" fill="#0B4EA2" />
          <text x="0" y="4.5" text-anchor="middle" fill="#FFFFFF" font-size="13" font-weight="900">{r.name}</text>
        </g>
      ); })}
      {rings.map((g) => { const [x, y] = ringLabel(g.r, g.deg); return (
        <g transform={`translate(${x} ${y})`}>
          <rect x="-29" y="-12" width="58" height="24" rx="12" fill="#FFFFFF" stroke="#0B4EA2" stroke-width="2" />
          <text x="0" y="5" text-anchor="middle" fill="#0B4EA2" font-size="13" font-weight="900" class="num">{g.t}</text>
        </g>
      ); })}
      {cities.map((c) => { const [x, y] = P(c.lat, c.lng); return (
        <g class={c.minor ? 'map-minor' : undefined}>
          <circle cx={x} cy={y} r="4.5" fill="#0B0C0C" />
          <text x={x + c.dx} y={y + c.dy} text-anchor={c.anchor ?? 'start'} fill="#0B0C0C" font-size="15" font-weight="800" class="map-city" paint-order="stroke" stroke="#FFFFFF" stroke-width="3.5" stroke-linejoin="round">{c.name}</text>
        </g>
      ); })}
      {towns.map((t) => { const o = townLabel[t.slug] ?? { dx: 8, dy: -6, anchor: 'start' as const }; return (
        <g class="map-minor">
          <circle cx={t.xy[0]} cy={t.xy[1]} r="3.5" fill="#0B0C0C" />
          <text x={t.xy[0] + o.dx} y={t.xy[1] + o.dy} text-anchor={o.anchor} fill="#0B0C0C" font-size="12" font-weight="800" paint-order="stroke" stroke="#FFFFFF" stroke-width="3" stroke-linejoin="round">{t.name}</text>
        </g>
      ); })}
      <circle cx={gx} cy={gy} r="8" fill="#FFD500" stroke="#0B0C0C" stroke-width="3" />
      <text x={gx + 12} y={gy + 5} fill="#0B0C0C" font-size="19" font-weight="900" paint-order="stroke" stroke="#FFFFFF" stroke-width="4" stroke-linejoin="round">Goole</text>
      <g class="map-minor" transform={`translate(20 ${H - 24})`} fill="#0B0C0C" font-size="13" font-weight="800">
        <path d={`M0 0 H${scale.toFixed(1)} M0 -5 V5 M${scale.toFixed(1)} -5 V5`} stroke="#0B0C0C" stroke-width="2.5" />
        <text x={scale + 8} y="5">25 miles</text>
      </g>
    </g>
  </svg>
  <figcaption class="mt-3 flex flex-wrap items-center gap-x-5 gap-y-2 t-small">
    <span class="inline-flex items-center gap-2"><span class="inline-block h-3.5 w-5 rounded-sm" style="background:#FFE27A;box-shadow:inset 0 0 0 1px #0B0C0C33"></span>Free call-out, up to {SITE.freeCalloutMiles} miles</span>
    <span class="inline-flex items-center gap-2"><span class="inline-block h-3.5 w-5 rounded-sm" style="background:#BFD4EF"></span>Up to 50 miles</span>
    <span class="inline-flex items-center gap-2"><span class="inline-block h-3.5 w-5 rounded-sm" style="background:#DCE8F7;box-shadow:inset 0 0 0 2px #0B4EA2"></span>Up to {SITE.operatingMiles} miles, travel quoted</span>
    <span>Straight-line distance from Goole; motorways simplified. Coastline: Natural Earth.</span>
  </figcaption>
</figure>
<style>
  @media (max-width: 639px) {
    figure :global(.map-minor) { display: none; }
    figure :global(.map-city) { font-size: 24px; }
  }
</style>
