---
/**
 * Coverage map, drawn to scale from real town coordinates (equirectangular projection, corrected for latitude).
 * Roads and the Humber are simplified polylines through approximate real points. Labelled as schematic.
 * Town status (free call-out vs quoted) comes from AREAS in site.ts.
 */
import { AREAS, SITE } from '../config/site';

/** `animate` draws the roads once on load. Only use it where the map is in the first viewport. */
interface Props { class?: string; showLegend?: boolean; id?: string; animate?: boolean }
const { class: className = '', showLegend = true, id = 'map', animate = false } = Astro.props;

const lon0 = -1.68, lon1 = -0.22, lat0 = 54.03, lat1 = 53.44;
const cosLat = Math.cos((53.73 * Math.PI) / 180);
const W = 640;
const k = W / ((lon1 - lon0) * cosLat);
const H = Math.round((lat0 - lat1) * k);
const P = (lat: number, lng: number) => [+((lng - lon0) * cosLat * k).toFixed(1), +((lat0 - lat) * k).toFixed(1)];
const line = (pts: number[][]) => 'M' + pts.map(([la, ln]) => P(la, ln).join(' ')).join(' L');

const water = [[53.705, -0.87], [53.7, -0.78], [53.7, -0.7], [53.715, -0.6], [53.72, -0.5], [53.735, -0.4], [53.725, -0.3], [53.7, -0.22]];
const roads = [
  { name: 'M62', key: true, pts: [[53.745, -1.62], [53.733, -1.57], [53.725, -1.51], [53.72, -1.43], [53.7, -1.34], [53.7, -1.25], [53.69, -1.1], [53.675, -0.98], [53.7, -0.885], [53.745, -0.86], [53.765, -0.69], [53.74, -0.55], [53.735, -0.42], [53.743, -0.34]] },
  { name: 'M18', key: true, pts: [[53.675, -0.98], [53.62, -0.97], [53.585, -0.985], [53.55, -1.06], [53.51, -1.1], [53.47, -1.17]] },
  { name: 'M180', key: false, pts: [[53.585, -0.985], [53.58, -0.85], [53.575, -0.7], [53.57, -0.62]] },
  { name: 'A1(M)', key: false, pts: [[53.47, -1.17], [53.52, -1.18], [53.6, -1.22], [53.7, -1.25], [53.8, -1.3], [53.9, -1.33], [54.0, -1.35]] },
];
const roadLabels = [
  { t: 'M62', at: P(53.715, -1.42), dy: 22 },
  { t: 'M18', at: P(53.56, -1.04), dy: 0, dx: -30 },
  { t: 'M180', at: P(53.578, -0.8), dy: 16 },
  { t: 'A1(M)', at: P(53.93, -1.34), dy: 0, dx: -44 },
  { t: 'Humber', at: P(53.7, -0.64), dy: 26, water: true },
];

const offsets: Record<string, { dx: number; dy: number; anchor: 'start' | 'end' }> = {
  goole: { dx: 22, dy: 2, anchor: 'start' },
  selby: { dx: -14, dy: -10, anchor: 'end' },
  leeds: { dx: 14, dy: -16, anchor: 'start' },
  york: { dx: 12, dy: 2, anchor: 'start' },
  doncaster: { dx: 12, dy: 10, anchor: 'start' },
  scunthorpe: { dx: 12, dy: 12, anchor: 'start' },
  hull: { dx: -14, dy: -26, anchor: 'end' },
};
const towns = AREAS.map((a) => ({ ...a, xy: P(a.lat, a.lng), o: offsets[a.slug] ?? { dx: 12, dy: 4, anchor: 'start' as const } }));
const tenMiles = (10 / 69.05) * k;
const desc =
  'Map of the FoxKey service area centred on Goole. ' +
  towns.map((t) => `${t.name}: ${t.slug === 'goole' ? 'our base' : `about ${t.roadMiles} road miles, ${t.free ? 'free call-out' : 'travel quoted upfront'}`}`).join('. ') +
  '.';
---
<figure class={className}>
  <svg viewBox={`0 0 ${W} ${H}`} class:list={['block h-auto w-full', animate && 'map-animated']} role="img" aria-labelledby={`${id}-t ${id}-d`}>
    <title id={`${id}-t`}>Where FoxKey covers from {SITE.baseTown}</title>
    <desc id={`${id}-d`}>{desc}</desc>

    <path d={line(water)} fill="none" stroke="var(--color-water)" stroke-width="7" stroke-linecap="round" stroke-linejoin="round" />
    <g>
      {roads.map((r) => <path d={line(r.pts)} pathLength="1" class:list={['map-road', r.key && 'is-key']} />)}
    </g>
    <g font-size="15" font-weight="700" letter-spacing="0.04em">
      {roadLabels.map((l) => (
        <text class="map-minor" x={l.at[0] + (l.dx ?? 0)} y={l.at[1] + l.dy} fill={l.water ? 'var(--color-water-label)' : 'var(--color-faint)'}>{l.t}</text>
      ))}
    </g>

    {towns.map((t) => (
      <g>
        {t.slug === 'goole' ? (
          <g>
            <circle cx={t.xy[0]} cy={t.xy[1]} r="18" fill="none" stroke="var(--color-fox)" stroke-opacity="0.45" stroke-width="1.5" />
            <circle cx={t.xy[0]} cy={t.xy[1]} r="8.5" fill="var(--color-fox)" />
          </g>
        ) : t.free ? (
          <circle cx={t.xy[0]} cy={t.xy[1]} r="7" fill="var(--color-fox)" />
        ) : (
          <circle cx={t.xy[0]} cy={t.xy[1]} r="6" fill="var(--color-bg)" stroke="var(--color-ink)" stroke-width="2.5" />
        )}
        <text x={t.xy[0] + t.o.dx} y={t.xy[1] + t.o.dy} text-anchor={t.o.anchor} fill="var(--color-ink)" font-size={t.slug === 'goole' ? 22 : 18} font-weight="800" class:list={['map-town', t.slug === 'goole' && 'is-base']}>{t.name}</text>
        <text x={t.xy[0] + t.o.dx} y={t.xy[1] + t.o.dy + 19} text-anchor={t.o.anchor} fill="var(--color-muted)" font-size="14.5" font-weight="600" class="num map-minor">
          {t.slug === 'goole' ? 'Our base' : `${t.roadMiles} mi`}
        </text>
      </g>
    ))}

    <g class="map-minor" transform={`translate(16 ${H - 22})`} fill="var(--color-muted)" font-size="14" font-weight="700">
      <path d={`M0 0 H${tenMiles.toFixed(1)}`} stroke="var(--color-muted)" stroke-width="2" />
      <path d={`M0 -4 V4 M${tenMiles.toFixed(1)} -4 V4`} stroke="var(--color-muted)" stroke-width="2" />
      <text x={tenMiles + 8} y="4">10 miles</text>
    </g>
    <g class="map-minor" transform={`translate(${W - 24} 28)`} fill="var(--color-faint)" font-size="14" font-weight="800" text-anchor="middle">
      <path d="M0 -12 L5 2 L0 -1 L-5 2 Z" fill="var(--color-faint)" />
      <text y="19">N</text>
    </g>
  </svg>
  {showLegend && (
    <figcaption class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-muted">
      <span class="inline-flex items-center gap-2"><svg width="12" height="12" aria-hidden="true"><circle cx="6" cy="6" r="5.5" fill="var(--color-fox)" /></svg>Free call-out</span>
      <span class="inline-flex items-center gap-2"><svg width="12" height="12" aria-hidden="true"><circle cx="6" cy="6" r="4.5" fill="none" stroke="var(--color-ink)" stroke-width="2" /></svg>Travel quoted upfront</span>
      <span>Schematic. Towns to scale, roads simplified, approximate road miles.</span>
    </figcaption>
  )}
</figure>
<style>
  /* Below 640px the map is ~340px wide: keep town names readable (about 15px rendered) and drop the secondary labels, which the coverage table repeats. */
  @media (max-width: 639px) {
    figure :global(.map-minor) { display: none; }
    figure :global(.map-town) { font-size: 28px; }
    figure :global(.map-town.is-base) { font-size: 32px; }
  }
</style>
