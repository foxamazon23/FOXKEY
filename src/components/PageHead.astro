---
/** Inner-page opener: breadcrumb, H1, one lead paragraph, optional actions slot. No eyebrow labels. */
interface Props { title: string; lead?: string; crumbs?: { label: string; href?: string }[]; long?: boolean }
const { title, lead, crumbs = [], long = false } = Astro.props;
const trail = [{ label: 'Home', href: '/' }, ...crumbs];
const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: trail.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.label, item: c.href ? new URL(c.href, Astro.site).href : new URL(Astro.url.pathname, Astro.site).href })),
};
---
<section class="border-b border-line">
  <div class="wrap pt-10 pb-12 md:pt-14 md:pb-16">
    <nav aria-label="Breadcrumb" class="mb-6 text-sm text-muted">
      <ol class="flex flex-wrap items-center gap-x-2 gap-y-1">
        {trail.map((c, i) => (
          <li class="flex items-center gap-2">
            {i > 0 && <span aria-hidden="true" class="text-faint">/</span>}
            {c.href && i < trail.length - 1 ? <a href={c.href} class="hover:text-ink">{c.label}</a> : <span aria-current="page" class="text-ink">{c.label}</span>}
          </li>
        ))}
      </ol>
    </nav>
    <h1 class:list={[long ? 't-h1' : 't-h1', 'max-w-4xl']}>{title}</h1>
    {lead && <p class="t-lead mt-5 max-w-2xl">{lead}</p>}
    <slot />
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</section>
