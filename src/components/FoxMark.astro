---
/** The FoxKey mark: a geometric fox head whose chin becomes a key blade. `hole` matches the background behind it. */
interface Props { class?: string; hole?: string; title?: string }
const { class: className = 'h-10 w-10', hole = '#FFFFFF', title } = Astro.props;
---
<svg class={className} viewBox="0 0 64 74" xmlns="http://www.w3.org/2000/svg" role={title ? 'img' : undefined} aria-label={title} aria-hidden={title ? undefined : 'true'}>
  <polygon points="4,4 22,16 32,16 32,54 4,30" fill="#F26A1B" />
  <polygon points="60,4 42,16 32,16 32,54 60,30" fill="#D55A12" />
  <polygon points="19,31 45,31 32,50" fill="#FFFFFF" />
  <polygon points="18,22 27,24 22,30" fill="#0B0C0C" />
  <polygon points="46,22 37,24 42,30" fill="#0B0C0C" />
  <polygon points="29,41 35,41 32,46" fill="#0B0C0C" />
  <circle cx="32" cy="11" r="3.2" fill={hole} />
  <rect x="29" y="50" width="6" height="22" rx="1" fill="#F26A1B" />
  <rect x="35" y="57" width="6" height="3.5" rx="0.5" fill="#F26A1B" />
  <rect x="35" y="64" width="4.5" height="3.5" rx="0.5" fill="#F26A1B" />
</svg>
