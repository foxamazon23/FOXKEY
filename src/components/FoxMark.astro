---
/** The FoxKey fox pictogram in one colour (currentColor). The chin runs into a key blade. */
import { FOX_VIEWBOX, FOX_HEAD, FOX_BLADE } from '../brand/fox.mjs';
interface Props { class?: string; title?: string }
const { class: className = 'h-10 w-9', title } = Astro.props;
---
<svg class={className} viewBox={FOX_VIEWBOX} xmlns="http://www.w3.org/2000/svg" role={title ? 'img' : undefined} aria-label={title} aria-hidden={title ? undefined : 'true'}>
  <path fill="currentColor" fill-rule="evenodd" d={FOX_HEAD} />
  <path fill="currentColor" d={FOX_BLADE} />
</svg>
