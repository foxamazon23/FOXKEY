---
/** A price list set like a workshop job sheet: service on the left, "from" price on the right, aligned figures. */
import { VAT_LABEL, type Service } from '../config/site';
interface Props { services: Service[]; caption: string; base?: string; callout?: { title: string; text: string }; compact?: boolean }
const { services, caption, base, callout, compact = false } = Astro.props;
---
<div class="overflow-x-auto">
  <table class="w-full border-collapse text-left">
    <caption class="sr-only">{caption}</caption>
    <thead>
      <tr class="border-b border-line-strong">
        <th scope="col" class="t-label py-3 pr-4 font-bold">Service</th>
        <th scope="col" class="t-label py-3 text-right font-bold whitespace-nowrap">From, {VAT_LABEL}</th>
      </tr>
    </thead>
    <tbody>
      {services.map((s) => (
        <tr class="border-b border-line align-baseline">
          <th scope="row" class:list={['pr-6 font-semibold text-ink', compact ? 'py-3.5' : 'py-4']}>
            {base ? <a href={`${base}#${s.id}`} class="underline decoration-line-strong decoration-1 underline-offset-4 transition-[color,border-color,text-decoration-color] hover:decoration-fox">{s.title}</a> : s.title}
            {!compact && s.priceNote && <span class="mt-1 block text-sm font-normal text-muted">{s.priceNote}</span>}
          </th>
          <td class:list={['num text-right text-xl font-extrabold whitespace-nowrap text-ink', compact ? 'py-3.5' : 'py-4']}>{s.priceFrom}</td>
        </tr>
      ))}
      {callout && (
        <tr class="border-b border-line align-baseline">
          <th scope="row" class="py-4 pr-6 font-semibold text-ink">{callout.title}</th>
          <td class="py-4 text-right text-xl font-extrabold text-ink">{callout.text}</td>
        </tr>
      )}
    </tbody>
  </table>
</div>
