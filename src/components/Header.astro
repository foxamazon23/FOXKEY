---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { NAV, SITE } from '../config/site';
const current = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? current === '/' : current === href || current.startsWith(href + '/'));
const links = NAV.filter((n) => n.href !== '/');
---
<header class="sticky z-40 border-b-4 border-sign bg-paper" style="top: env(safe-area-inset-top, 0px)">
  <div class="wrap flex h-[4.25rem] items-center gap-6 lg:h-[4.75rem]">
    <Logo />
    <nav aria-label="Main" class="ml-auto hidden xl:block">
      <ul class="flex items-center gap-1">
        {links.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={[
                'block rounded-sm px-2.5 py-2 t-ui font-bold whitespace-nowrap',
                isActive(item.href) ? 'text-ink underline decoration-sign decoration-[3px] underline-offset-[10px]' : 'text-ink no-underline hover:underline hover:decoration-2 hover:underline-offset-[10px]',
              ]}
            >{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="ml-auto hidden items-center gap-2 md:flex xl:ml-3">
      <a href={SITE.whatsapp} target="_blank" rel="noopener" class="btn btn-outline btn-wa btn-sm"><Icon name="whatsapp" class="h-[1.1rem] w-[1.1rem]" />WhatsApp</a>
      <a href={`tel:${SITE.phoneTel}`} class="btn btn-call btn-sm num"><Icon name="phone" class="h-[1.1rem] w-[1.1rem]" />{SITE.phoneDisplay}</a>
    </div>
    <button id="nav-toggle" type="button" class="ml-auto inline-flex h-11 w-11 items-center justify-center rounded-sm border-2 border-ink text-ink md:ml-2 xl:hidden" aria-expanded="false" aria-controls="nav-panel">
      <span class="sr-only" data-label>Open menu</span>
      <Icon name="menu" class="h-5 w-5" data-open />
      <Icon name="x" class="hidden h-5 w-5" data-close />
    </button>
  </div>
  <nav id="nav-panel" aria-label="Main" class="hidden border-t-2 border-line-soft bg-paper xl:hidden">
    <ul class="wrap grid gap-x-8 py-2 sm:grid-cols-2">
      {NAV.map((item) => (
        <li>
          <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined} class:list={['flex min-h-12 items-center justify-between border-b border-line-soft text-[1.0625rem] font-extrabold text-ink', isActive(item.href) ? 'underline decoration-sign decoration-[3px] underline-offset-8' : 'no-underline']}>
            {item.label}<Icon name="arrow-right" class="h-4 w-4 text-sign" />
          </a>
        </li>
      ))}
      <li class="flex gap-3 pt-4 pb-3 sm:col-span-2">
        <a href="/quote" class="btn btn-outline flex-1">Get a quote</a>
        <a href="/fleet" class="btn btn-outline flex-1">Fleet enquiry</a>
      </li>
    </ul>
  </nav>
</header>
<script>
  const btn = document.getElementById('nav-toggle');
  const panel = document.getElementById('nav-panel');
  btn?.addEventListener('click', () => {
    const open = panel!.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(open));
    btn.querySelector('[data-label]')!.textContent = open ? 'Close menu' : 'Open menu';
    btn.querySelector('[data-open]')?.classList.toggle('hidden', open);
    btn.querySelector('[data-close]')?.classList.toggle('hidden', !open);
  });
</script>
