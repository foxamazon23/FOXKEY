---
import { VAT_LABEL, type Service } from '../config/site';
interface Props { service: Service; level?: 'h2' | 'h3'; tip?: string }
const { service: s, level: H = 'h2', tip } = Astro.props;
---
<article id={s.id} class="grid gap-x-10 gap-y-3 border-b-2 border-line-soft py-9 first:pt-1 md:grid-cols-[minmax(0,1fr)_9.5rem]">
  <div>
    <H class="text-[1.5rem] leading-snug font-black tracking-[-0.015em]">{s.title}</H>
    <p class="mt-3 t-body measure text-ink">{s.description}</p>
    {tip && <p class="mt-3 measure t-ui"><strong>Tip:</strong> {tip}</p>}
    {s.priceNote && <p class="mt-3 t-ui font-bold">{s.priceNote}</p>}
  </div>
  <p class="flex items-baseline gap-2 md:flex-col md:items-end md:gap-0">
    <span class="t-small">from</span>
    <span class="num text-[2.25rem] leading-none font-black tracking-[-0.02em]">{s.priceFrom}</span>
    <span class="t-small md:mt-1">{VAT_LABEL}</span>
  </p>
</article>
