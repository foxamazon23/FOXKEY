---
import Icon from './Icon.astro';
import { OWNERSHIP_PROOF } from '../config/site';
interface Props { class?: string; headingLevel?: 'h2' | 'h3' }
const { class: className = '', headingLevel: H = 'h3' } = Astro.props;
---
<aside class={`flex gap-4 rounded-md border-2 border-sign bg-sign-soft p-5 sm:p-6 ${className}`} aria-label={OWNERSHIP_PROOF.title}>
  <Icon name="id-card" class="mt-0.5 h-6 w-6 shrink-0 text-sign" />
  <div>
    <H class="font-extrabold">{OWNERSHIP_PROOF.title}</H>
    <p class="mt-1 t-ui">{OWNERSHIP_PROOF.text}</p>
  </div>
</aside>
