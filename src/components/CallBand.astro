---
import Icon from './Icon.astro';
import { SITE } from '../config/site';
interface Props { title?: string; text?: string }
const { title = 'Stuck right now?', text = `Ring and tell us the make, model and where it is. We agree the price before we set off.` } = Astro.props;
---
<section class="band rule">
  <div class="wrap grid items-end gap-8 lg:grid-cols-[1fr_auto]">
    <div>
      <h2 class="t-h2">{title}</h2>
      <p class="t-lead mt-4 max-w-xl">{text}</p>
    </div>
    <div class="flex flex-wrap gap-3">
      <a href={`tel:${SITE.phoneTel}`} class="btn btn-call btn-lg num w-full sm:w-auto"><Icon name="phone" class="h-5 w-5" />Call {SITE.phoneDisplay}</a>
      <a href={SITE.whatsappPrefill} target="_blank" rel="noopener" class="btn btn-wa btn-lg w-full sm:w-auto"><Icon name="message-circle" class="h-5 w-5" />WhatsApp</a>
    </div>
  </div>
</section>
