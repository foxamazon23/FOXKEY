---
import Icon from './Icon.astro';
import { SITE, HOME } from '../config/site';
interface Props { title?: string; text?: string }
const { title = HOME.close.title, text = HOME.close.text } = Astro.props;
---
<section class="bg-plate text-plate-ink">
  <div class="wrap band-sm grid items-center gap-6 lg:grid-cols-[1fr_auto]">
    <div>
      <h2 class="t-h2">{title}</h2>
      <p class="mt-3 max-w-xl text-[1.125rem] leading-relaxed">{text}</p>
    </div>
    <div class="flex flex-wrap gap-3">
      <a href={`tel:${SITE.phoneTel}`} class="btn btn-ink btn-lg num w-full sm:w-auto"><Icon name="phone" class="h-5 w-5" />Call {SITE.phoneDisplay}</a>
      <a href={SITE.whatsappPrefill} target="_blank" rel="noopener" class="btn btn-outline btn-lg w-full sm:w-auto">WhatsApp</a>
    </div>
  </div>
</section>
