---
import Icon from './Icon.astro';
import type { Faq as FaqItem } from '../config/site';
interface Props { items: FaqItem[] }
const { items } = Astro.props;
---
<div class="border-t border-line">
  {items.map((f) => (
    <details class="group border-b border-line">
      <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-6 py-4 text-left text-[1.0625rem] font-bold text-ink [&::-webkit-details-marker]:hidden">
        <span>{f.q}</span>
        <Icon name="chevron-down" class="h-5 w-5 shrink-0 text-muted group-open:rotate-180" />
      </summary>
      <p class="max-w-3xl pb-6 t-body">{f.a}</p>
    </details>
  ))}
</div>
