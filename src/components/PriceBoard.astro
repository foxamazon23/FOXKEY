---
/** Price list: service on the left, "from" price on the right, a yellow row for the free call-out. */
import { VAT_LABEL, type Service } from '../config/site';
interface Props { services: Service[]; caption: string; base?: string; callout?: { title: string; text: string }; compact?: boolean; titleOf?: (s: Service) => string }
const { services, caption, base, callout, compact = false, titleOf = (s: Service) => s.title } = Astro.props;
---
<div class="overflow-x-auto">
  <table class="w-full border-collapse text-left">
    <caption class="sr-only">{caption}</caption>
    <thead>
      <tr class="border-b-[3px] border-ink">
        <th scope="col" class="t-label py-2.5 pr-4">Service</th>
        <th scope="col" class="t-label py-2.5 text-right whitespace-nowrap">From, {VAT_LABEL}</th>
      </tr>
    </thead>
    <tbody>
      {services.map((s) => (
        <tr class="border-b border-line align-baseline">
          <th scope="row" class:list={['pr-6 font-bold', compact ? 'py-3' : 'py-4']}>
            {base ? <a href={`${base}#${s.id}`} class="link font-bold">{titleOf(s)}</a> : titleOf(s)}
            {!compact && s.priceNote && <span class="mt-1 block t-small font-normal">{s.priceNote}</span>}
          </th>
          <td class:list={['num text-right text-[1.375rem] font-black whitespace-nowrap', compact ? 'py-3' : 'py-4']}>{s.priceFrom}</td>
        </tr>
      ))}
      {callout && (
        <tr class="bg-plate-soft align-baseline">
          <th scope="row" class="px-3 py-3.5 font-bold">{callout.title}</th>
          <td class="px-3 py-3.5 text-right text-[1.375rem] font-black">{callout.text}</td>
        </tr>
      )}
    </tbody>
  </table>
</div>
